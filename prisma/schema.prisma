generator client {
  provider = "prisma-client-js"
}

// F-13: real enums, not bare String. Zod validates the API path, but
// nothing guarded a Prisma Studio edit, a seed script, or a manual SQL fix
// — a single 'Pending' where the code expects 'PENDING' made a row
// invisible to every filter, with no error anywhere. Value sets below are
// taken from actual usage (grepped across the codebase and cross-checked
// against the matching Zod schema), not assumed.
enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEAM_LEADER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
  OFFLINE
  /// The contract ended. Login is gone and the person is out of every
  /// ordinary list, but the record stays whole: their name, work history and
  /// pay records have to remain so past months stay explainable and a payslip
  /// can be reissued years later.
  ///
  /// Distinct from SUSPENDED, which is temporary and reversible and says
  /// nothing about whether they are still employed, and from DELETED, which
  /// is an administrative removal rather than the end of a contract.
  ARCHIVED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  PENDING_CONFIRMATION
  APPROVED
  REJECTED
  COMPLETED
}

enum TaskPaymentStatus {
  PENDING_PAYMENT
  PAID
}

enum ObligationRecurrence {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// The five trial lengths offered at company creation. A real enum rather than
// a day count, because the options mix two units — "1 month" is not 30 days —
// and a closed set belongs in the database rather than in a dropdown's markup.
enum TrialPreset {
  TWO_DAYS
  SEVEN_DAYS
  FOURTEEN_DAYS
  ONE_MONTH
  THREE_MONTHS
}

enum DayOffType {
  REGULAR
  SICK
  EMERGENCY
  UNPAID
  CASUAL
}

// F-27: what a short-lived emailed code is being used to prove. One shared
// VerificationCode mechanism, four purposes, rather than four separate
// ad-hoc flows.
enum VerificationPurpose {
  EMAIL_VERIFY
  EMAIL_CHANGE
  MFA_RECOVERY
  PASSWORD_RESET
}

datasource db {
  provider = "postgresql"
  // No url here any more. Prisma 7 refuses connection strings in the schema
  // and takes them from prisma.config.ts (for the CLI) and from the driver
  // adapter in lib/prisma.ts (for the running app). Both still read the vars
  // Vercel's Supabase integration keeps in sync — POSTGRES_PRISMA_URL is the
  // pooled one the app uses, POSTGRES_URL_NON_POOLING the direct one migrate
  // needs — so nothing about where the URLs come from has changed, only
  // which file names them.
}

// A sellable package. Rows are created and edited by a Super Admin in the UI so
// pricing and packaging change without a deploy.
//
// Feature switches are explicit typed columns, not a JSON blob: this codebase
// has already made that call twice (JSON-in-text to real columns, loose strings
// to enums) because it lets the compiler catch misuse. There are two of them,
// not eight — see the bundles section of the plan.
model Package {
  id                   String    @id @default(uuid())
  name                 String    @unique
  description          String?
  // Deactivated, never deleted. Setting isActive false removes a package from
  // the assignment dropdown while every company already on it keeps working.
  // A hard delete is unsafe: those companies' packageId would fall to null,
  // which in this design means grandfathered — silently handing paying
  // customers a free upgrade to everything. The FK below refuses it outright.
  isActive             Boolean   @default(true)
  // A bespoke per-contract package is assignable without appearing in the
  // standard catalogue.
  isPublic             Boolean   @default(true)
  priceMonthly         Decimal   @default(0) @db.Decimal(12, 2)
  priceAnnual          Decimal   @default(0) @db.Decimal(12, 2)
  // Null means this package is not sold as a lifetime purchase at all, which is
  // different from being sold for nothing.
  priceLifetime        Decimal?  @db.Decimal(12, 2)
  hasCompanyManagement Boolean   @default(false)
  hasHR                Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  companies            Company[]

  @@index([isActive])
}

model Company {
  id                   String                @id @default(uuid())
  name                 String                @unique
  isBanned             Boolean               @default(false)
  // Company Settings: whether a submitted task location auto-verifies
  // against the task's target location at all, for any task belonging to
  // this company. The distance threshold itself is a system-wide setting
  // (SystemSettings.locationVerifyRadiusMeters) — this is deliberately
  // company policy only, not per-task, so one company can't quietly
  // change what another company's tasks do.
  autoVerifyLocation   Boolean               @default(true)
  // Per-company module names and icons, keyed by the module keys in
  // lib/modules.ts. Null, or a missing key, falls through to the built-in
  // default, so every existing company is untouched.
  //
  // These replaced a single `vendorsLabel` column, which is why Vendors is the
  // one module with customers already relying on a rename. Only a Super Admin
  // sets these (Company Settings) — the lists themselves are managed by that
  // company's own Admin, the same split this app uses everywhere between "who
  // owns naming policy" and "who owns the day-to-day data".
  //
  // Json rather than a column per module — deliberately the opposite call to
  // Package's feature switches. There the set is small, closed and load-bearing
  // for gating, so the compiler should police it. Here it is nine free-text
  // values that gate nothing, and the set grows whenever a module is added; a
  // migration per new module would be pure ceremony. parseModuleOverrides is
  // what narrows the untyped Json back to a known shape on the way out.
  moduleLabels         Json?
  moduleIcons          Json?
  // This company's own mark, shown in the sidebar in place of the default one.
  // Null is not a missing logo, it is a company that never uploaded one — and
  // that company looks exactly as it did before this column existed.
  //
  // A URL rather than bytes: it is minted by the logo endpoint from a file that
  // endpoint itself uploaded, never accepted as a string from a client. That
  // distinction is the whole security of the field — a settable logoUrl would
  // let a Super Admin be talked into pointing every page load of a company's
  // dashboard at somebody else's server.
  logoUrl              String?
  // Null means grandfathered: every feature on, no gating. Every company that
  // existed before packages shipped is untouched, and stays that way until
  // somebody deliberately assigns one.
  packageId            String?
  // Trial length, chosen at creation. Null means this company predates the
  // trial feature — resolveSubscriptionState treats that as grandfathered, not
  // as an expired trial. Locking a live customer because a column is null is
  // the worst failure this feature could have.
  trialPreset          TrialPreset?
  // Only ever grows. Extensions are counted in days whatever the preset, since
  // "give them another week" is how the request always arrives. Kept apart from
  // the preset so "how often do we extend, and by how much" is answerable
  // without reading an audit log.
  trialExtensionDays   Int                   @default(0)
  // Which lifecycle notices have already gone out for the current period:
  // TRIAL_ENDING_24H, GRACE_STARTED, GRACE_ENDING_24H, LOCKED.
  //
  // Same shape and reasoning as CompanyPayment.remindersSent. It matters more
  // here: two of these are emails, and lib/email.ts sends through one Gmail
  // account with no queue and no retry — the same account that carries password
  // resets and MFA codes. A job that re-sent every morning would get it
  // rate-limited, which does not merely annoy a customer, it locks people out
  // of the product.
  //
  // Cleared whenever a date moves (payment confirmed, trial or grace extended),
  // because that starts a new period which deserves its notices again. Cleared
  // wholesale rather than selectively: sending one notice twice after an
  // extension is a much smaller failure than never sending it at all.
  lifecycleNoticesSent String[]              @default([])
  /// The day of the month this company pays on.
  ///
  /// Load-bearing rather than cosmetic: it is what decides which side of payday
  /// a leaver falls on, and therefore whether a final settlement pays them or
  /// bills them. P5's preview assumed 25 because this column did not exist yet.
  ///
  /// 1-28, validated in code. Not 29-31: a payroll day that does not occur in
  /// February is a payroll day that silently moves, and "the 30th" meaning the
  /// 28th in one month out of twelve is the kind of rule nobody remembers when
  /// they are reading a payslip.
  payrollDay           Int                   @default(25)
  /// Whether an employee can see their own payslip at all.
  ///
  /// Off by default, and deliberately so: turning payslips on is a decision a
  /// company makes once, knowingly. A default of "on" would publish pay records
  /// to every employee of every existing company on the deploy that adds them.
  payslipsVisible      Boolean               @default(false)
  /// The most of one month's net that debt recovery may take, as a percentage.
  ///
  /// 100 is the agreed behaviour today: a debt is collected out of the next
  /// month in full. The column exists so that changing that is a number in a
  /// form rather than a change to how payroll works — chained across months,
  /// uncapped recovery can take somebody's pay to zero twice running with
  /// nobody deciding it should, and most jurisdictions limit it for that
  /// reason. 0 switches recovery off without deleting anybody's debt.
  debtRecoveryPercent  Int                   @default(100)
  /// The calendar this company's months are measured in.
  ///
  /// Everything in lib/time.ts already takes a zone as an argument; this is
  /// where the argument finally comes from. Validated, not merely stored — see
  /// lib/timezone.ts for why the accepted set is narrower than the IANA list.
  timezone             String                @default("Africa/Cairo")
  payrollRuns          PayrollRun[]
  finalSettlements     FinalSettlement[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  businessClients      BusinessClient[]
  package              Package?              @relation(fields: [packageId], references: [id], onDelete: Restrict)
  lockedAttempts       LockedModuleAttempt[]
  payments             CompanyPayment[]
  obligations          Obligation[]
  requests             Request[]
  tasks                Task[]
  users                User[]
  vendors              Vendor[]
  roles                Role[]                @relation("CompanyRoles")
  roleRequests         RoleRequest[]
  /// The role a new account starts on (ROLES_PLAN.md §6.4). Null means the
  /// company's built-in Employee role — every company has one, so nobody is
  /// ever created without a role, even while a request for another waits.
  defaultRoleId        String?
  defaultRole          Role?                 @relation("CompanyDefaultRole", fields: [defaultRoleId], references: [id], onDelete: SetNull)
}

// System Settings: a single-row table (id is always "default") for
// platform-wide configuration a super admin manages from its own page —
// deliberately separate from Company, which holds per-company policy.
// Add new global settings here as plain columns, same pattern as this
// first one.
// How often each company's users reach for a module their package does not
// include. Because a gated module stays visible and locked, every attempt
// already arrives at the server as a request — so the signal exists to be
// counted without a single client-side event.
//
// A tally per company per module, never per person. The count answers the
// commercial question ("eleven people at Cura Tech tried to open Payroll this
// month"); storing which individual employee clicked what is behavioural data
// about a customer's staff, with real privacy weight and no extra sales value.
model LockedModuleAttempt {
  id        String   @id @default(uuid())
  companyId String
  module    String
  // Bucketed by month rather than one row per click: the question is a trend,
  // and an unbounded event log for something this repetitive is a table nobody
  // ever prunes. Stored as the first day of the month, UTC.
  month     DateTime
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, module, month])
  @@index([companyId])
  @@index([month])
}

model SystemSettings {
  id                         String   @id @default("default")
  locationVerifyRadiusMeters Int      @default(70)
  maintenanceMode            Boolean  @default(false)
  maintenanceMessage         String?
  // The "Powered by SHSD" mark in the corner of every dashboard page.
  // Defaults on, so the signature keeps showing unless somebody deliberately
  // turns it off — a default that silently removed attribution would be a
  // strange thing for an upgrade to do.
  showPoweredBy              Boolean  @default(true)
  // The name in that mark. A column rather than a constant, so the attribution
  // can be changed without a deploy — rebranding, or a reseller putting their
  // own name on it. Defaults to SHSD, which is what it read before it moved
  // out of the component.
  poweredByName              String   @default("SHSD")
  /// The calendar zone for anybody with no company — a Super Admin, or a user
  /// whose companyId is null. Resolution is company, then this, then the
  /// constant in lib/time.ts, so the fallback is never re-improvised at a call
  /// site.
  defaultTimezone            String   @default("Africa/Cairo")
  updatedAt                  DateTime @updatedAt
}

model SuperAdmin {
  id                 String             @id @default(uuid())
  email              String             @unique
  password           String
  firstName          String
  lastName           String
  avatar             String?
  gender             String             @default("MALE")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  language           String             @default("en")
  // Three states, not a boolean: "system" is the default and means follow the
  // operating system, which is what most people want and what every app they
  // already use does. A boolean cannot express it.
  theme              String             @default("light")
  username           String             @unique
  sessionVersion     Int                @default(0)
  mustChangePassword Boolean            @default(false)
  // Founder-account protection: enforced by a DB trigger (see the
  // add_superadmin_protection migration), not just app code, since a
  // direct SQL DELETE bypasses application logic entirely. Deliberately a
  // per-row flag rather than hardcoded emails/IDs in application logic —
  // the same "magic identifier baked into code" pattern F-04 already
  // fixed once for credentials.
  isProtected        Boolean            @default(false)
  // F-27 MFA. mfaEnabled is always true and locked on for a protected
  // SuperAdmin (enforced in app logic — see SuperAdminService); mfaSecret
  // is reversibly encrypted with MFA_ENCRYPTION_KEY, not hashed, since the
  // server has to read it back to compute the expected TOTP code on every
  // login. Distinct key from F-02's deleted ENCRYPTION_KEY — different
  // purpose, never to be confused with it.
  mfaEnabled         Boolean            @default(false)
  mfaSecret          String?
  emailVerifiedAt    DateTime?
  auditLogs          AuditLog[]
  notifications      Notification[]
  trustedDevices     TrustedDevice[]
  verificationCodes  VerificationCode[]
}

model User {
  id                         String                  @id @default(uuid())
  email                      String                  @unique
  password                   String
  firstName                  String
  lastName                   String
  role                       UserRole
  avatar                     String?
  gender                     String                  @default("MALE")
  companyId                  String?
  status                     UserStatus              @default(OFFLINE)
  lastActivity               DateTime                @default(now())
  totalDifficultyPoints      Int                     @default(0)
  // F-07: Decimal, not Float. Float is IEEE-754 double precision; repeated
  // arithmetic on it drifts (0.1 + 0.2 !== 0.3 in floating point), which is
  // unacceptable for a value that gets paid out. Applies to every money/
  // payroll-day field below and in Task, SalaryRecord, SalaryAdjustment,
  // and CompanyPayment.
  salary                     Decimal                 @default(0) @db.Decimal(12, 2)
  language                   String                  @default("en")
  // Three states, not a boolean: "system" is the default and means follow the
  // operating system, which is what most people want and what every app they
  // already use does. A boolean cannot express it.
  theme                      String                  @default("light")
  dayOffCredit               Float                   @default(0)
  baseDayOffCredit           Float                   @default(0)
  // No @default: a hardcoded year here meant every account created after
  // that year started with its reset year already in the past, so the
  // first credit reset would wipe a leave balance it had just been given.
  // UserService.create sets this from the account's actual creation year.
  lastDayOffResetYear        Int
  username                   String                  @unique
  sessionVersion             Int                     @default(0)
  mustChangePassword         Boolean                 @default(false)
  // F-27 MFA — see the matching fields on SuperAdmin for the reasoning on
  // why mfaSecret is encrypted, not hashed.
  mfaEnabled                 Boolean                 @default(false)
  mfaSecret                  String?
  emailVerifiedAt            DateTime?
  // Who manages this person. Null means nobody does — the state every account
  // starts in, and the one an Admin has to clear deliberately.
  //
  // A self-relation rather than a Team table because the structure is flat:
  // leaders are not led. So this is only ever set on an EMPLOYEE row and only
  // ever points at a TEAM_LEADER in the same company, which makes a reporting
  // cycle impossible by construction rather than by a check somebody has to
  // remember. Scope stays one comparison instead of a tree walk.
  //
  // Those two rules live in UserService, not here, because a column cannot see
  // another row. The one invariant Postgres can hold on its own — that nobody
  // leads themselves — is a CHECK constraint in the migration.
  //
  // SetNull is a backstop for a hard DELETE only. The app soft-deletes, and
  // losing a leader that way is refused until their reports are rehomed. A
  // leader's reports must never quietly become invisible to everybody.
  teamLeaderId               String?
  teamLeader                 User?                   @relation("TeamMembers", fields: [teamLeaderId], references: [id], onDelete: SetNull)
  teamMembers                User[]                  @relation("TeamMembers")
  auditLogs                  AuditLog[]
  trustedDevices             TrustedDevice[]
  verificationCodes          VerificationCode[]
  createdClients             BusinessClient[]        @relation("ClientCreatedBy")
  editedClients              BusinessClient[]        @relation("ClientEditedBy")
  createdBusinessClientNotes BusinessClientNote[]    @relation("CreatedNotes")
  editedBusinessClientNotes  BusinessClientNote[]    @relation("EditedNotes")
  createdSections            BusinessClientSection[] @relation("SectionCreatedBy")
  editedSections             BusinessClientSection[] @relation("SectionEditedBy")
  createdVendors             Vendor[]                @relation("VendorCreatedBy")
  dayOffCreditSnapshots      DayOffCreditSnapshot[]
  dayOffRequests             DayOffRequest[]
  notifications              Notification[]
  profileUpdateRequests      ProfileUpdateRequest[]
  requests                   Request[]
  salaryAdjustments          SalaryAdjustment[]
  salaryRecords              SalaryRecord[]
  createdTasks               Task[]                  @relation("CreatedTasks")
  company                    Company?                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks                      Task[]                  @relation("MultipleAssignees")
  obligations                Obligation[]            @relation("ObligationAssignees")
  createdObligations         Obligation[]            @relation("ObligationCreatedBy")
  SalaryChange               SalaryChange[]
  EmploymentEvent            EmploymentEvent[]
  payslips                   Payslip[]
  finalSettlements           FinalSettlement[]
  debts                      Debt[]
  /// The role this person holds (ROLES_PLAN.md §3.1): what they may do comes
  /// from its grants. `role` above is its base role, copied from it whenever a
  /// role is assigned — RoleAssignmentService is the only writer of either,
  /// and the database refuses a pair that disagree (see the migration).
  ///
  /// Null only for a row whose role is SUPER_ADMIN, who is outside the role
  /// system, or for an account with no company, which no company role can
  /// belong to.
  roleId                     String?
  assignedRole               Role?                   @relation(fields: [roleId], references: [id], onDelete: NoAction)
  roleRequestsFor            RoleRequest[]           @relation("RoleRequestFor")
  roleRequestsMade           RoleRequest[]           @relation("RoleRequestBy")
  roleRequestsDecided        RoleRequest[]           @relation("RoleRequestDecidedBy")

  @@index([email])
  @@index([companyId])
  @@index([status])
  @@index([role])
  // Every Team Leader read filters on this, on every page they open.
  @@index([teamLeaderId])
  // "Who holds this role" — every role edit counts its holders first.
  @@index([roleId])
}

model Task {
  id                  String            @id @default(uuid())
  title               String
  description         String
  status              TaskStatus
  deadline            DateTime
  difficulty          Int               @default(0)
  totalCost           Decimal           @default(0) @db.Decimal(12, 2)
  createdBy           String?
  // F-12: Json, not String. These held JSON serialized into text — Postgres
  // couldn't validate, index, or query any of it, and the app already had to
  // defend itself against malformed rows (maintenance.service.ts silently
  // treats an unparseable attachments row as orphaned and deletes it).
  attachments         Json?
  comments            Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  isEdited            Boolean           @default(false)
  isTransfer          Boolean           @default(false)
  paymentStatus       TaskPaymentStatus @default(PENDING_PAYMENT)
  location            String?
  lastStatusUpdateBy  String?
  lastEditBy          String?
  memberCosts         Json?
  memberPaymentStatus Json?
  companyId           String?
  // Vendors feature: set when this task's location was chosen by picking a
  // vendor rather than typing one — location/locationLink above are still
  // the source of truth for display (copied from the vendor at creation
  // time), this is only the formal link back for future reporting. Deleting
  // a vendor never touches historical tasks — SetNull just detaches the
  // reference, the copied location text stays exactly as it was.
  vendorId            String?
  company             Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor              Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  creator             User?             @relation("CreatedTasks", fields: [createdBy], references: [id], onDelete: SetNull)
  assignees           User[]            @relation("MultipleAssignees")

  @@index([createdBy])
  @@index([companyId])
  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
  // F-26: the hot paths filter on these pairs together (company task lists
  // scoped by status; deadline-sorted views scoped by company) — a
  // single-column index can only serve one side of that filter per scan.
  @@index([companyId, status])
  @@index([companyId, deadline])
}

// A notification is addressed to exactly one recipient, and a recipient is
// either a company User or a platform SuperAdmin. Those live in two separate
// tables with independent UUID spaces, so the recipient is polymorphic: one of
// the two FK columns is set and the other is null.
//
// Why this exists: this model used to hang off User alone with a NOT NULL
// userId. CompanyService.checkSubscriptions() has always collected its
// recipients from the SuperAdmin table, so every insert it attempted violated
// Notification_userId_fkey — no SUBSCRIPTION_EXPIRY notification had ever been
// written, and the Super Admin bell could not have shown one even in principle.
//
// "Exactly one of the two is set" is enforced by a CHECK constraint
// (Notification_recipient_exactly_one, num_nonnulls(...) = 1) rather than
// anything expressible here — Prisma has no syntax for it, so it lives in the
// polymorphic_notification_recipient migration. Don't assume the schema file
// tells the whole story for this table.
//
// Readers should match a recipient with `OR: [{ userId: id }, { superAdminId: id }]`
// rather than branching on role. An id can only ever satisfy one of the two, and
// the role on a session is not a reliable discriminator: the codebase also
// supports a User row carrying role 'SUPER_ADMIN', whose notifications belong
// under userId.
model Notification {
  id           String      @id @default(uuid())
  userId       String?
  superAdminId String?
  type         String
  message      String
  read         Boolean     @default(false)
  relatedId    String?
  createdAt    DateTime    @default(now())
  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  // F-26: the notification bell always filters "this recipient's unread items".
  @@index([userId, read])
  @@index([superAdminId])
  @@index([superAdminId, read])
}

model AuditLog {
  id           String      @id @default(uuid())
  action       String
  entityType   String
  entityId     String
  userId       String?
  superAdminId String?
  // F-12: Json, not String — see the note on Task.attachments above.
  details      Json?
  createdAt    DateTime    @default(now())
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: SetNull)
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  // F-26: the audit log page's default view is newest-first, filterable by
  // action — the two are always sorted/filtered together there.
  @@index([createdAt, action])
}

// F-27: short-lived one-time codes emailed to prove control of an inbox —
// backs email verification, email change, MFA's email-fallback recovery,
// and forgot-password. `email` is the address the code was actually sent
// to (matters for EMAIL_CHANGE, where that's the *new* address, not
// whatever's on the account row yet). The code itself is hashed, not
// stored raw — a 6-digit code doesn't need bcrypt's cost factor, just
// enough that a DB dump alone doesn't hand out working codes. `attempts`
// backs rate-limiting wrong guesses against a single code.
model VerificationCode {
  id           String              @id @default(uuid())
  userId       String?
  superAdminId String?
  email        String
  codeHash     String
  purpose      VerificationPurpose
  attempts     Int                 @default(0)
  consumedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime            @default(now())
  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  superAdmin   SuperAdmin?         @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([superAdminId])
  @@index([email, purpose])
}

// F-27: a device that has already completed an MFA challenge once, so it
// isn't asked again until this expires or is revoked. `tokenHash`, like
// VerificationCode.codeHash, never stores the raw token actually sitting
// in the browser's cookie.
model TrustedDevice {
  id           String      @id @default(uuid())
  userId       String?
  superAdminId String?
  tokenHash    String      @unique
  label        String?
  createdAt    DateTime    @default(now())
  lastUsedAt   DateTime    @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([superAdminId])
}

model Obligation {
  id                 String               @id @default(uuid())
  title              String
  description        String
  recurrence         ObligationRecurrence @default(ONE_TIME)
  deadline           DateTime
  difficulty         Int                  @default(0)
  status             String
  attachments        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  lastStatusUpdateBy String?
  companyId          String?
  company            Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignees          User[]               @relation("ObligationAssignees")
  // Never captured before now — every row that existed before this column
  // was added has this as NULL for that reason, not because a Super Admin
  // made it. The app's own display logic accounts for that (see the
  // ObligationDetailPage rollout-cutoff comment) rather than assuming NULL
  // always means Super Admin, the way it safely can for Task/Vendor.
  createdById        String?
  createdBy          User?                @relation("ObligationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([companyId])
  @@index([createdAt])
}

model SalaryRecord {
  id         String   @id @default(uuid())
  userId     String
  month      Int
  year       Int
  totalDays  Int
  deductions Decimal  @default(0) @db.Decimal(12, 2)
  bonusDays  Decimal  @default(0) @db.Decimal(12, 2)
  baseSalary Decimal  @default(0) @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId])
  @@index([month])
  @@index([year])
}

model BusinessClient {
  id             String                  @id @default(uuid())
  name           String
  companyId      String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  createdById    String?
  lastEditedById String?
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy      User?                   @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastEditedBy   User?                   @relation("ClientEditedBy", fields: [lastEditedById], references: [id], onDelete: SetNull)
  sections       BusinessClientSection[]

  @@unique([name, companyId])
  @@map("Client")
}

model BusinessClientSection {
  id             String               @id @default(uuid())
  title          String
  clientId       String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  createdById    String?
  lastEditedById String?
  notes          BusinessClientNote[]
  client         BusinessClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy      User?                @relation("SectionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastEditedBy   User?                @relation("SectionEditedBy", fields: [lastEditedById], references: [id], onDelete: SetNull)

  @@unique([title, clientId])
  @@map("ClientSection")
}

model BusinessClientNote {
  id                 String                @id @default(uuid())
  content            String
  sectionId          String
  createdById        String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  attachment         String?
  expiryDate         DateTime?
  notifiedDaysBefore Boolean               @default(false)
  notifiedOnExpiry   Boolean               @default(false)
  reminderDays       Int?
  lastEditedAt       DateTime?
  lastEditedById     String?
  createdBy          User?                 @relation("CreatedNotes", fields: [createdById], references: [id], onDelete: SetNull)
  lastEditedBy       User?                 @relation("EditedNotes", fields: [lastEditedById], references: [id], onDelete: SetNull)
  section            BusinessClientSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("ClientNote")
}

model ProfileUpdateRequest {
  id           String   @id @default(uuid())
  userId       String
  oldFirstName String
  oldLastName  String
  newFirstName String
  newLastName  String
  status       String   @default("PENDING")
  adminNote    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model CompanyPayment {
  id                     String    @id @default(uuid())
  companyId              String
  cost                   Decimal   @db.Decimal(12, 2)
  subscriptionType       String
  status                 String    @default("UNPAID")
  paidAt                 DateTime?
  startDate              DateTime?
  endDate                DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  // Superseded by remindersSent. Kept for one deploy so a code rollback still
  // has the column it reads; dropped in the contract step of this change.
  notifiedExpiryReminder Boolean   @default(false)
  // Which rungs of the 14/3/1 expiry ladder have been spent on this period.
  // A set, not a counter or a boolean: the old single flag could say "something
  // was sent" but not which, so it could neither drive a ladder nor survive an
  // extension. Reset to empty whenever endDate moves — an extended period is a
  // new period and deserves its reminders again.
  remindersSent          Int[]     @default([])
  // Extra grace beyond the standard 48 hours, granted by a Super Admin. Stored
  // as the gift rather than as a computed graceUntil, so the deadline stays a
  // conclusion drawn from dates rather than a column that can drift.
  graceExtensionHours    Int       @default(0)
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([paidAt])
  @@index([endDate])
}

model DayOffRequest {
  id              String     @id @default(uuid())
  userId          String
  type            DayOffType
  status          String     @default("PENDING")
  reason          String?
  date            DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  daysDeducted    Float?     @default(0)
  endDate         DateTime?
  deductionType   String     @default("CREDIT")
  // Set by the admin/super admin when they reject the request. Distinct from
  // `reason`, which is the employee's own justification for asking. Null on
  // every row rejected before this column existed, and on any request that
  // was rejected without one being typed.
  rejectionReason String?
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  // F-26: "this user's requests, filtered by status" is the shape both the
  // employee view and the admin approval queue query.
  @@index([userId, status])
}

/// A bonus or deduction, in days, against one month's salary record.
///
/// The two columns that matter most here are the ones that were missing. An
/// adjustment belongs to a *period*, and until now that period was inferred
/// from createdAt every time anybody needed it — so an adjustment could only
/// ever mean "this month", and reversing one re-derived the month rather than
/// reading where it actually landed. Same lesson as SalaryChange: when a thing
/// happened and what it is about are two different facts.
model SalaryAdjustment {
  id        String   @id @default(uuid())
  userId    String
  type      String
  amount    Decimal  @db.Decimal(12, 2)
  reason    String?
  /// ACTIVE, ROLLED_BACK or REVERSED. The last two are both terminal and mean
  /// different things: rolled back is "this should never have existed",
  /// reversed is "this was right and is now being undone". Conflating them
  /// loses the only thing a reader of the history wants to know.
  status    String   @default("ACTIVE")
  /// The month this adjustment belongs to — 1-12, and the year beside it.
  /// Stored, not derived: a deduction agreed on 2 October for September's
  /// payroll is ordinary, and a column computed from the write time cannot
  /// express it. It also pins which SalaryRecord was incremented, so undoing
  /// one cannot decrement a different row than the one it touched.
  month     Int
  year      Int
  /// Where it came from: MANUAL, TASK_PENALTY, DAY_OFF or SETTLEMENT.
  source    String   @default("MANUAL")
  /// The task, day-off request or settlement it belongs to. The day-off path
  /// used to find its own adjustment with `reason: { contains: id }` — a free
  /// text field an admin can edit, matched by substring.
  sourceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([userId, year, month])
  @@index([source, sourceId])
}

model Request {
  id           String    @id @default(uuid())
  title        String
  details      String
  status       String    @default("PENDING")
  userId       String
  companyId    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  inProgressAt DateTime?
  completedAt  DateTime?
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model DayOffCreditSnapshot {
  id              String   @id @default(uuid())
  userId          String
  year            Int
  baseCredit      Float
  remainingCredit Float
  /// Set only on a row the reset had to reconstruct.
  ///
  /// The reset runs once a year and has no retry, so a missed run leaves years
  /// with no snapshot — and because this table is unique on [userId, year],
  /// they can never be filled in afterwards. The reset now writes a row for
  /// every missed year rather than one, and says so here, because a
  /// reconstructed closing balance is a different kind of fact from a measured
  /// one and a reader deserves to be able to tell.
  note            String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([userId])
}

model Vendor {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  ownerName    String
  mobileNumber String
  // Mirrors Task.location's {name, link} shape (stored there as JSON text)
  // so copying a vendor's location into a task at creation time is a direct
  // field-to-field copy, no reshaping needed on either side.
  locationName String
  locationLink String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation("VendorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tasks        Task[]

  @@unique([name, companyId])
  @@index([companyId])
}

/// One row per scheduled job, rewritten on every run.
///
/// Before this, all six jobs recorded only their failures — each calls
/// AuditLogService.logSystemError from its catch block and writes nothing on
/// success. Two things followed from that, and the second is the reason this
/// table exists.
///
/// "When did salary-init last work?" was unanswerable from inside the app:
/// there was no record that any job had ever succeeded. And worse, a job that
/// stops firing altogether leaves no trace at all — an error writes a row,
/// silence writes nothing. That is how the yearly day-off reset has gone its
/// entire life without running and without anyone noticing, and it is the one
/// failure no alert built on errors can ever catch.
///
/// So this separates the two states that were indistinguishable from outside:
/// nothing went wrong, and nothing happened.
///
/// Deliberately a single row per job rather than a log of runs. The question
/// being asked is "is this job alive", and a history of runs answers it more
/// slowly, grows without bound, and needs its own pruning job — which would
/// then also need watching.
model JobHeartbeat {
  /// The cron path's own name, e.g. "salary-init". Stable across deploys, so
  /// it is the key rather than a generated id.
  job            String    @id
  lastRunAt      DateTime
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  /// Truncated: this is shown on a dashboard card, not used for debugging.
  /// The audit log still holds the full error and its reference.
  lastError      String?
  lastDurationMs Int?
  /// Consecutive failures, reset to zero by a success. One failure is noise;
  /// three in a row is a broken job.
  failureStreak  Int       @default(0)
  updatedAt      DateTime  @updatedAt
}

/// Every salary a person has been on, and from when.
///
/// Before this, salary was one mutable number on User with no history: change
/// it and the previous value was gone. That is fine for "what do we pay them
/// now" and useless for "what were they owed in March", which is the question a
/// payslip answers — and the question a dispute about a payslip turns on.
///
/// Effective-dated rather than versioned, because the two are not the same. A
/// change entered on the 20th that takes effect from the 1st is ordinary, and a
/// version history keyed on when a row was written cannot express it. The
/// this-month-or-next prompt the admin answers becomes this date, so the answer
/// outlives the moment it was given.
///
/// User.salary stays as the current rate. It is the value every existing screen
/// reads and the one a person is on today; this table is what happened, and the
/// two are kept in step by SalaryHistoryService writing both together.
model SalaryChange {
  id            String   @id @default(uuid())
  userId        String
  /// The new monthly salary, not a delta. A history of deltas cannot be read
  /// without replaying all of it, and one bad row poisons everything after.
  monthlyAmount Decimal  @db.Decimal(12, 2)
  /// The instant this rate starts applying, stored UTC like every other
  /// timestamp. Derived from a calendar date in the company's zone, so a
  /// change effective "1 October" begins when October begins for them.
  effectiveFrom DateTime
  reason        String?
  /// Null for the backfill, and for anything a system job records.
  createdById   String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The query is always "this user's changes, in order", and always bounded by
  /// a month. Deliberately not unique on [userId, effectiveFrom]: two changes
  /// dated the same day is a correction entered after the fact, and the later
  /// row wins rather than the write failing.
  @@index([userId, effectiveFrom])
}

/// What happened to somebody's employment, and when.
///
/// The companion to SalaryChange: that one answers "what were they paid", this
/// one answers "were they employed at all, and were they working". A payslip
/// needs both, and neither can be reconstructed from a mutable status field —
/// User.status says what is true now, and says nothing about March.
///
/// Effective-dated for the same reason as SalaryChange. A contract end entered
/// on the 3rd for a last working day of the 30th of last month is ordinary, and
/// the date that matters is the one the event happened on, not the one somebody
/// typed it on.
model EmploymentEvent {
  id               String              @id @default(uuid())
  userId           String
  type             EmploymentEventType
  /// The instant the event takes effect. For CONTRACT_ENDED this is the
  /// *first* instant they are no longer employed, so the last working day is
  /// the day before — stored this way because every window in the calculation
  /// is half-open at the end, and two conventions in one codebase is a day's
  /// pay lost or gained somewhere.
  effectiveFrom    DateTime
  reason           String?
  /// UNSUSPENDED only: whether the suspension that just ended is deducted from
  /// pay. Null everywhere else, and null on an UNSUSPENDED means the question
  /// has not been answered yet rather than "no".
  ///
  /// A decision made after the fact, on purpose. Suspension in this system only
  /// stops somebody logging in; whether it costs them pay is for the admin to
  /// decide when they know why it happened, which is usually at the end.
  deductSuspension Boolean?
  createdById      String?
  createdAt        DateTime            @default(now())
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveFrom])
}

enum EmploymentEventType {
  /// Backfilled at the epoch for everyone who already existed: User has no
  /// createdAt, so there is no hire date to use and inventing one would put a
  /// false fact in a column every payslip reads.
  HIRED
  SUSPENDED
  UNSUSPENDED
  CONTRACT_ENDED
  /// A contract end undone — the person is employed again, continuously. Not
  /// the same as a new HIRED, which would start a second period of employment.
  REINSTATED
}

/// One company's payroll for one month.
///
/// The unit of approval. Figures live on the payslips below and are frozen when
/// this moves out of DRAFT — after that the run is a record of what was paid,
/// not a view that recomputes. That distinction is the whole reason this table
/// exists: without it, opening last March's payroll would show today's answer to
/// March's question, and the two would differ every time anything changed.
model PayrollRun {
  id           String            @id @default(uuid())
  companyId    String
  /// 1-12, in the company's own calendar.
  month        Int
  year         Int
  status       PayrollRunStatus  @default(DRAFT)
  approvedAt   DateTime?
  approvedById String?
  paidAt       DateTime?
  paidById     String?
  /// What the company's payroll day was when this ran. Copied, not read back
  /// through Company: changing the payroll day must not rewrite what a past
  /// settlement was measured against.
  payrollDay   Int
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payslips     Payslip[]
  settlements  FinalSettlement[]

  /// One run per company per month. A second draft for a month that already has
  /// one is how two people approve different figures for the same payroll.
  @@unique([companyId, month, year])
  @@index([companyId, year, month])
  @@index([status])
}

enum PayrollRunStatus {
  DRAFT
  /// Figures frozen. Payslips exist and can be issued; the money has not moved.
  APPROVED
  PAID
}

/// One person's pay for one month, as issued.
///
/// Totals are stored rather than derived. They are sums of the lines below —
/// never a re-derivation from the underlying rates — because that is what makes
/// the printed lines add up to the printed total. A document whose column does
/// not sum to the figure beneath it reads as an error however it is explained.
model Payslip {
  id               String        @id @default(uuid())
  payrollRunId     String
  userId           String
  earningsAmount   Decimal       @default(0) @db.Decimal(12, 2)
  deductionsAmount Decimal       @default(0) @db.Decimal(12, 2)
  /// Never negative. What the deductions could not take is carried out as a
  /// debt instead — see Debt, and totalPayslip() in lib/payroll.ts.
  netAmount        Decimal       @default(0) @db.Decimal(12, 2)
  /// The excess the net could not absorb. Zero on an ordinary payslip.
  carriedAmount    Decimal       @default(0) @db.Decimal(12, 2)
  /// Days actually paid for. Less than the month for a joiner, a leaver, or a
  /// suspension that was ruled deductible.
  daysPaid         Int
  /// Kept out of the run's totals, but still shown. An excluded person with no
  /// row at all is a person nobody notices is missing, which is the failure a
  /// register exists to prevent.
  excluded         Boolean       @default(false)
  exclusionReason  String?
  /// Stamped as each send succeeds, so a bulk issue resumes rather than
  /// restarting — the difference between a timeout costing a pause and sixty
  /// people receiving their payslip twice.
  emailedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  payrollRun       PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines            PayslipLine[]

  @@unique([payrollRunId, userId])
  @@index([userId])
  @@index([emailedAt])
}

/// One line on a payslip. Always positive; the kind carries the sign.
model PayslipLine {
  id        String          @id @default(uuid())
  payslipId String
  kind      PayslipLineKind
  label     String
  amount    Decimal         @db.Decimal(12, 2)
  /// Where it came from, on the same reasoning as SalaryAdjustment.source: a
  /// line somebody disputes has to be traceable to the thing that caused it,
  /// and matching on the label is matching on free text.
  source    String          @default("MANUAL")
  sourceId  String?
  /// Print order, so a reissued payslip is identical to the original.
  sortOrder Int             @default(0)
  payslip   Payslip         @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
  @@index([source, sourceId])
}

enum PayslipLineKind {
  EARNING
  DEDUCTION
}

/// What is owed when a contract ends, in either direction.
///
/// Produced the moment the contract ends, not when the money moves: the
/// document and the payment are different events, and an employee who has left
/// is entitled to the statement before payday comes round.
///
/// The net is signed, which is the point. Positive means the company owes;
/// negative means the person does. Two columns, or an unsigned amount beside a
/// direction flag, allow a state where the sign and the figure disagree — and
/// the one thing a settlement must never be is ambiguous about which way it
/// points.
model FinalSettlement {
  id             String           @id @default(uuid())
  userId         String
  companyId      String
  /// The last day they were employed. The contract ends at the start of the
  /// next one, matching EmploymentEvent's half-open convention.
  lastWorkingDay DateTime
  /// What the final month's worked days were worth.
  earnedAmount   Decimal          @db.Decimal(12, 2)
  /// What had already gone out for that month when the contract ended.
  paidAmount     Decimal          @default(0) @db.Decimal(12, 2)
  /// earned − paid. Positive: the company owes. Negative: the person owes.
  ///
  /// Deliberately still just that, after debt netting arrived: the document
  /// shows earned, paid and their difference, and a net that quietly included
  /// something else would stop adding up in front of the person reading it.
  netAmount      Decimal          @db.Decimal(12, 2)
  /// What this settlement took back against debts the person already owed.
  ///
  /// A separate line rather than folded into netAmount, and capped at netAmount
  /// so a settlement can never bill somebody on their way out. What it could
  /// not reach stays an OUTSTANDING debt — see I1.
  debtRecoveredAmount Decimal     @default(0) @db.Decimal(12, 2)
  status         SettlementStatus @default(PENDING)
  /// Defaults to the settlement date and is editable when something else is
  /// agreed, so the list of what is outstanding is a queue rather than a pile.
  dueDate        DateTime
  /// Set when a payroll run picks this up to pay or collect it. Null while it
  /// is waiting for one.
  payrollRunId   String?
  reason         String?
  emailedAt      DateTime?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollRun     PayrollRun?      @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([userId])
  @@index([dueDate])
}

enum SettlementStatus {
  /// Produced, not yet carried by a payroll run.
  PENDING
  APPROVED
  PAID
  /// Written off deliberately, with a reason. Distinct from PAID, which claims
  /// money moved.
  WAIVED
}

/// Money a person owes the company, from wherever it arose.
///
/// Two things produce one: a payslip whose deductions exceeded its earnings
/// (the net floors at zero and the excess is carried), and a final settlement
/// that came out negative. They are the same object to whoever has to collect
/// it, so they are one table with a source rather than two lists that have to
/// be merged and sorted by hand every time somebody asks what is outstanding.
model Debt {
  id        String     @id @default(uuid())
  userId    String
  companyId String
  amount    Decimal    @db.Decimal(12, 2)
  /// What payroll has taken back so far. Kept separate from `amount` rather
  /// than subtracted from it, because the original obligation is the thing
  /// somebody disputes and a column that shrinks cannot answer "how much was
  /// this to begin with".
  recoveredAmount Decimal @default(0) @db.Decimal(12, 2)
  /// PAYSLIP_CARRY or SETTLEMENT, and the row it came from.
  source    String
  sourceId  String?
  status    DebtStatus @default(OUTSTANDING)
  dueDate   DateTime
  settledAt DateTime?
  reason    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, status, dueDate])
  @@index([userId])
  @@index([source, sourceId])
}

enum DebtStatus {
  OUTSTANDING
  SETTLED
  WAIVED
}

/// How far a grant reaches: the person's own records, their team's, or the
/// whole company's. The same three values as `Scope` in
/// lib/permissions/catalogue.ts.
enum PermissionScope {
  OWN
  TEAM
  COMPANY
}

/// A company's role: a name, a base role, and the permissions it grants
/// (ROLES_PLAN.md §3.1, §5). Every company has the three built-in ones, which
/// the migration and CompanyService create with the grants in
/// lib/permissions/built-in.ts; the Super Admin adds others.
model Role {
  id                   String      @id @default(uuid())
  companyId            String
  company              Company     @relation("CompanyRoles", fields: [companyId], references: [id], onDelete: Cascade)
  defaultFor           Company[]   @relation("CompanyDefaultRole")
  name                 String
  description          String?
  /// What kind of person holds it — team structure, subscription exemption,
  /// who may create whom still read this, through User.role (§2.3).
  baseRole             UserRole
  /// Which built-in role this is, or null for one the Super Admin made. At
  /// most one of each per company.
  builtIn              UserRole?
  /// Bumped on every change to the role or its grants, so sessions reload
  /// them within a minute (§4.4).
  version              Int         @default(1)
  /// The template it was copied from — informational, never a live link.
  copiedFromTemplateId String?
  grants               RoleGrant[]
  users                User[]
  requests             RoleRequest[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@unique([companyId, name])
  @@unique([companyId, builtIn])
}

/// One permission a role holds, at one scope. Rows rather than a Json column
/// because "who can do this?" is a query by permission across roles (§5).
model RoleGrant {
  roleId     String
  role       Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// A key from lib/permissions/catalogue.ts. Checked when written.
  permission String
  scope      PermissionScope

  @@id([roleId, permission])
  @@index([permission, roleId])
}

/// A starting point the Super Admin keeps for roles companies commonly need —
/// HR Officer, Branch Manager, Accountant (ROLES_PLAN.md §6.1). A company's
/// role is a copy of one, never a live link: changing a template changes no
/// company until the Super Admin chooses to offer it (§6.8).
model RoleTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  baseRole    UserRole
  /// [{ permission, scope }], checked against the catalogue when written. Json
  /// rather than rows: nothing queries into a template.
  grants      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A request to give somebody a role, made by someone who may only ask —
/// typically HR — and decided by someone who may assign (ROLES_PLAN.md §6.12).
/// The person keeps their role until it is decided. At most one pending per
/// person (a partial unique index in the migration).
model RoleRequest {
  id            String            @id @default(uuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId        String
  user          User              @relation("RoleRequestFor", fields: [userId], references: [id], onDelete: Cascade)
  roleId        String
  role          Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User              @relation("RoleRequestBy", fields: [requestedById], references: [id], onDelete: Cascade)
  note          String?
  status        RoleRequestStatus @default(PENDING)
  decidedById   String?
  decidedBy     User?             @relation("RoleRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decisionNote  String?
  decidedAt     DateTime?
  /// When the deciders were last reminded of it, if it waited (§6.12).
  remindedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([companyId, status])
  @@index([userId])
}
