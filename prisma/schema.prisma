generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id              String           @id @default(uuid())
  name            String           @unique
  isBanned        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  businessClients BusinessClient[]
  payments        CompanyPayment[]
  users           User[]
}

model SuperAdmin {
  id        String     @id @default(uuid())
  email     String     @unique
  username  String?    @unique
  password  String
  firstName String
  lastName  String
  avatar    String?
  gender    String     @default("MALE")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  language         String     @default("en")
  plainPasswordEnc String?
  auditLogs        AuditLog[]
}

model User {
  id                         String                  @id @default(uuid())
  email                      String                  @unique
  username                   String?                 @unique
  password                   String
  firstName                  String
  lastName                   String
  role                       String
  avatar                     String?
  gender                     String                  @default("MALE")
  companyId                  String?
  status                     String                  @default("OFFLINE")
  lastActivity               DateTime                @default(now())
  totalDifficultyPoints      Int                     @default(0)
  salary                     Float?                  @default(0)
  language                   String                  @default("en")
  dayOffCredit               Float                   @default(0)
  baseDayOffCredit           Float                   @default(0)
  lastDayOffResetYear        Int                     @default(2024)
  auditLogs                  AuditLog[]
  createdClients             BusinessClient[]        @relation("CreatedClients")
  editedClients              BusinessClient[]        @relation("EditedClients")
  createdBusinessClientNotes BusinessClientNote[]    @relation("CreatedNotes")
  editedBusinessClientNotes  BusinessClientNote[]    @relation("EditedNotes")
  createdSections            BusinessClientSection[] @relation("CreatedSections")
  editedSections             BusinessClientSection[] @relation("EditedSections")
  dayOffRequests             DayOffRequest[]
  notifications              Notification[]
  obligations                Obligation[]
  requests                   Request[]
  profileUpdateRequests      ProfileUpdateRequest[]
  salaryAdjustments          SalaryAdjustment[]
  salaryRecords              SalaryRecord[]
  dayOffCreditSnapshots      DayOffCreditSnapshot[]
  plainPasswordEnc           String?
  tasks                      Task[]                  @relation("AssignedTasks")
  createdTasks               Task[]                  @relation("CreatedTasks")
  company                    Company?                @relation(fields: [companyId], references: [id])
  assignedTasks              Task[]                  @relation("TaskAssignees")

  @@index([email])
  @@index([companyId])
  @@index([status])
  @@index([role])
}

model Task {
  id                 String   @id @default(uuid())
  title              String
  description        String
  status             String
  deadline           DateTime
  difficulty         Int      @default(0)
  totalCost          Float    @default(0)
  assigneeId         String
  createdBy          String?
  attachments        String?
  comments           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  isEdited           Boolean  @default(false)
  isTransfer         Boolean  @default(false)
  paymentStatus      String   @default("PENDING_PAYMENT")
  location           String?
  lastStatusUpdateBy String?
  lastEditBy         String?
  memberCosts        Json?
  memberPaymentStatus Json?
  assignee           User     @relation("AssignedTasks", fields: [assigneeId], references: [id])
  creator            User?    @relation("CreatedTasks", fields: [createdBy], references: [id])
  assignees          User[]   @relation("TaskAssignees")

  @@index([assigneeId])
  @@index([createdBy])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  relatedId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id           String      @id @default(uuid())
  action       String
  entityType   String
  entityId     String
  userId       String?
  superAdminId String?
  details      String?
  createdAt    DateTime    @default(now())
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id])
  user         User?       @relation(fields: [userId], references: [id])
}

model Obligation {
  id                 String   @id @default(uuid())
  title              String
  description        String
  assigneeId         String
  recurrence         String   @default("ONE_TIME")
  deadline           DateTime
  difficulty         Int      @default(0)
  status             String
  attachments        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lastStatusUpdateBy String?
  assignee           User     @relation(fields: [assigneeId], references: [id])

  @@index([assigneeId])
  @@index([status])
  @@index([createdAt])
}

model SalaryRecord {
  id         String   @id @default(uuid())
  userId     String
  month      Int
  year       Int
  totalDays  Int
  deductions Float    @default(0)
  bonusDays  Float    @default(0)
  baseSalary Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, month, year])
  @@index([userId])
  @@index([month])
  @@index([year])
}

model BusinessClient {
  id             String                  @id @default(uuid())
  name           String
  companyId      String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  createdById    String?
  lastEditedById String?
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy      User?                   @relation("CreatedClients", fields: [createdById], references: [id])
  lastEditedBy   User?                   @relation("EditedClients", fields: [lastEditedById], references: [id])
  sections       BusinessClientSection[]

  @@unique([name, companyId])
  @@map("Client")
}

model BusinessClientSection {
  id             String               @id @default(uuid())
  title          String
  clientId       String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  createdById    String?
  lastEditedById String?
  notes          BusinessClientNote[]
  client         BusinessClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy      User?                @relation("CreatedSections", fields: [createdById], references: [id])
  lastEditedBy   User?                @relation("EditedSections", fields: [lastEditedById], references: [id])

  @@unique([title, clientId])
  @@map("ClientSection")
}

model BusinessClientNote {
  id                 String                @id @default(uuid())
  content            String
  sectionId          String
  createdById        String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  attachment         String?
  expiryDate         DateTime?
  notifiedDaysBefore Boolean               @default(false)
  notifiedOnExpiry   Boolean               @default(false)
  reminderDays       Int?
  lastEditedAt       DateTime?
  lastEditedById     String?
  createdBy          User?                 @relation("CreatedNotes", fields: [createdById], references: [id])
  lastEditedBy       User?                 @relation("EditedNotes", fields: [lastEditedById], references: [id])
  section            BusinessClientSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("ClientNote")
}

model ProfileUpdateRequest {
  id           String   @id @default(uuid())
  userId       String
  oldFirstName String
  oldLastName  String
  newFirstName String
  newLastName  String
  status       String   @default("PENDING")
  adminNote    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model CompanyPayment {
  id                     String    @id @default(uuid())
  companyId              String
  cost                   Float
  subscriptionType       String
  status                 String    @default("UNPAID")
  paidAt                 DateTime?
  startDate              DateTime?
  endDate                DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  notifiedExpiryReminder Boolean   @default(false)
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
}

model DayOffRequest {
  id            String    @id @default(uuid())
  userId        String
  type          String
  status        String    @default("PENDING")
  reason        String?
  date          DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  daysDeducted  Float?    @default(0)
  endDate       DateTime?
  deductionType String?   @default("CREDIT")
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model SalaryAdjustment {
  id        String   @id @default(uuid())
  userId    String
  type      String
  amount    Float
  reason    String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([status])
}

model DayOffCreditSnapshot {
  id              String   @id @default(uuid())
  userId          String
  year            Int
  baseCredit      Float
  remainingCredit Float
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([year])
}

model Request {
  id           String   @id @default(uuid())
  title        String
  details      String
  status       String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  userId       String
  companyId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  inProgressAt DateTime?
  completedAt  DateTime?
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@index([status])
}
