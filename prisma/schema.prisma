generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      String   // "SUPER_ADMIN" | "ADMIN" | "TEAM_LEADER" | "EMPLOYEE"
  avatar    String?
  gender    String   @default("MALE") // "MALE" | "FEMALE"
  status    String   @default("OFFLINE") // "ACTIVE" (green - logged in), "OFFLINE" (orange - logged out), "SUSPENDED" (red - cannot login)
  lastActivity DateTime @default(now()) // Track last activity for auto-offline
  totalDifficultyPoints Int @default(0) // Accumulated difficulty points from completed tasks/obligations
  salary                Float?  @default(0) // Monthly Base Salary
  tasks     Task[]   @relation("AssignedTasks")
  obligations Obligation[]
  notifications Notification[]
  auditLogs     AuditLog[]
  salaryRecords SalaryRecord[]
  createdTasks Task[]   @relation("CreatedTasks")
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String
  status      String   // "PENDING", "IN_PROGRESS", "SUBMITTED", "APPROVED", "REJECTED"
  deadline    DateTime
  difficulty  Int      @default(0) // 0-10 difficulty score
  totalCost   Float    @default(0) // Total accumulated cost in EGP
  assigneeId  String
  assignee    User     @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdBy   String?
  attachments String?  // JSON string
  comments    String?  // JSON string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isEdited    Boolean  @default(false)
  paymentStatus String @default("PENDING_PAYMENT") // "PENDING_PAYMENT", "PAID"
  location    String?  // GPS coordinates or address where task was worked on
  lastStatusUpdateBy String? // "Team Leader Ahmed", "Employee Sarah", etc.
  creator     User?    @relation("CreatedTasks", fields: [createdBy], references: [id])
}



model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // "TASK_ASSIGNED", "TASK_SUBMITTED", "TASK_APPROVED", "TASK_REJECTED", "OBLIGATION_DUE"
  message   String
  read      Boolean  @default(false)
  relatedId String?  // ID of the related task or obligation
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String   // "CREATE_TASK", "SUBMIT_TASK", "APPROVE_TASK", "DELETE_OBLIGATION", etc.
  entityType String   // "TASK", "OBLIGATION", "USER"
  entityId   String
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  details    String?  // JSON string for extra details
  createdAt  DateTime @default(now())
}

model Obligation {
  id          String   @id @default(uuid())
  title       String
  description String
  assigneeId  String
  assignee    User     @relation(fields: [assigneeId], references: [id])
  recurrence  String   @default("ONE_TIME") // "ONE_TIME", "MONTHLY"
  deadline    DateTime
  difficulty  Int      @default(0) // 0-10 difficulty score
  status      String   // "PENDING", "COMPLETED"
  attachments String?  // JSON string for evidence
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastStatusUpdateBy String?
}

model SalaryRecord {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  month     Int      // 1-12
  year      Int
  totalDays Int      // Days in the month (28-31)
  deductions Float    @default(0) // Accumulated fractions (0.25, 0.5, etc.) in DAYS
  bonusDays  Float    @default(0) // Accumulated DAYS
  baseSalary Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year])
}
