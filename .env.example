# Copy to .env and fill in real values. Never commit the real .env file.

# ---- Database (Supabase Postgres via Prisma) ----
# On Vercel, both of these are kept in sync automatically by the Supabase
# Storage integration (Vercel dashboard → Storage → maktab project) — you
# won't normally set these by hand there, and they update themselves when
# the DB password is rotated in Supabase. Set them manually only for a
# local .env running against the same database.
# Pooled connection (port 6543) — used by the app at runtime.
POSTGRES_PRISMA_URL="postgresql://postgres.[YOUR-ID]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used for migrations.
POSTGRES_URL_NON_POOLING="postgresql://postgres.[YOUR-ID]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ---- Supabase Storage ----
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT].supabase.co"
# Service-role key: full storage/DB access — server-only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Auth (NextAuth.js) ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ---- Cron / scheduled jobs (see vercel.json) ----
# Generate with: openssl rand -base64 32
# Vercel automatically sends this as `Authorization: Bearer $CRON_SECRET`
# when it invokes a scheduled route.
CRON_SECRET=""

# ---- Seed script (prisma/seed.ts) ----
# Required to run `npx tsx prisma/seed.ts` — it refuses to run without at
# least SEED_ADMIN_EMAIL_1 / SEED_ADMIN_PASSWORD_1. _2 is optional, for a
# second super-admin account. Password must be 12+ characters.
SEED_ADMIN_EMAIL_1="you@example.com"
SEED_ADMIN_PASSWORD_1=""
# SEED_ADMIN_USERNAME_1=""
# SEED_ADMIN_FIRST_NAME_1=""
# SEED_ADMIN_LAST_NAME_1=""
# SEED_ADMIN_GENDER_1="MALE"
# SEED_ADMIN_EMAIL_2=""
# SEED_ADMIN_PASSWORD_2=""

# ---- F-27: outbound email (verification codes, MFA recovery, forgot password) ----
# Gmail SMTP via a dedicated account, not a transactional email provider —
# the app has no domain to verify with one. GMAIL_USER is that account's
# address; GMAIL_APP_PASSWORD is a 16-character app password generated
# under that account's Google Account → Security → App passwords (requires
# 2-Step Verification on first). Leaving these unset makes
# sendVerificationCodeEmail() throw — nothing silently no-ops here, unlike
# Sentry below, since email delivery is load-bearing for login (MFA
# recovery, forgot-password) once F-27 ships.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# ---- F-27: MFA secret encryption ----
# Generate with: openssl rand -base64 32
# Encrypts SuperAdmin.mfaSecret / User.mfaSecret at rest. Reversible by
# design (the server has to read it back to compute the expected TOTP
# code), unlike a password hash — deliberately a distinct key from F-02's
# deleted ENCRYPTION_KEY, never to be confused with it.
MFA_ENCRYPTION_KEY=""

# ---- Optional: manual backup trigger (app/api/admin/maintenance/backup) ----
# Fine-grained GitHub PAT scoped to just this repo, "Contents: read and write".
# GITHUB_DISPATCH_TOKEN=""

# ---- Optional: location search (components/LocationSearchInput.tsx) ----
# NEXT_PUBLIC_HERE_API_KEY=""

# ---- Optional: error tracking (Sentry) ----
# Leaving these unset disables Sentry entirely — the SDK no-ops without a DSN.
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""
