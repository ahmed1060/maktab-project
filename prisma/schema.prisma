generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id              String           @id @default(uuid())
  name            String           @unique
  isBanned        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  businessClients BusinessClient[]
  users           User[]
  payments        CompanyPayment[]
}

model SuperAdmin {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  firstName String
  lastName  String
  avatar    String?
  gender    String     @default("MALE")
  language  String     @default("en")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditLogs AuditLog[]
}

model User {
  id                         String                 @id @default(uuid())
  email                      String                 @unique
  password                   String
  firstName                  String
  lastName                   String
  role                       String
  avatar                     String?
  gender                     String                 @default("MALE")
  language                   String                 @default("en")
  companyId                  String?
  status                     String                 @default("OFFLINE")
  lastActivity               DateTime               @default(now())
  totalDifficultyPoints      Int                    @default(0)
  salary                     Float?                 @default(0)
  auditLogs                  AuditLog[]
  createdBusinessClientNotes BusinessClientNote[]
  notifications              Notification[]
  obligations                Obligation[]
  profileUpdateRequests      ProfileUpdateRequest[]
  salaryRecords              SalaryRecord[]
  tasks                      Task[]                 @relation("AssignedTasks")
  createdTasks               Task[]                 @relation("CreatedTasks")
  dayOffCredit               Float                  @default(0)
  dayOffRequests             DayOffRequest[]
  company                    Company?               @relation(fields: [companyId], references: [id])

  @@index([email])
  @@index([companyId])
  @@index([status])
  @@index([role])
}

model Task {
  id                 String   @id @default(uuid())
  title              String
  description        String
  status             String
  deadline           DateTime
  difficulty         Int      @default(0)
  totalCost          Float    @default(0)
  assigneeId         String
  createdBy          String?
  attachments        String?
  comments           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  isEdited           Boolean  @default(false)
  isTransfer         Boolean  @default(false)
  paymentStatus      String   @default("PENDING_PAYMENT")
  location           String?
  lastStatusUpdateBy String?
  lastEditBy         String?
  assignee           User     @relation("AssignedTasks", fields: [assigneeId], references: [id])
  creator            User?    @relation("CreatedTasks", fields: [createdBy], references: [id])

  @@index([assigneeId])
  @@index([createdBy])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  relatedId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id           String      @id @default(uuid())
  action       String
  entityType   String
  entityId     String
  userId       String?
  superAdminId String?
  details      String?
  createdAt    DateTime    @default(now())
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id])
  user         User?       @relation(fields: [userId], references: [id])
}

model Obligation {
  id                 String   @id @default(uuid())
  title              String
  description        String
  assigneeId         String
  recurrence         String   @default("ONE_TIME")
  deadline           DateTime
  difficulty         Int      @default(0)
  status             String
  attachments        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lastStatusUpdateBy String?
  assignee           User     @relation(fields: [assigneeId], references: [id])

  @@index([assigneeId])
  @@index([status])
  @@index([createdAt])
}

model SalaryRecord {
  id         String   @id @default(uuid())
  userId     String
  month      Int
  year       Int
  totalDays  Int
  deductions Float    @default(0)
  bonusDays  Float    @default(0)
  baseSalary Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, month, year])
  @@index([userId])
  @@index([month])
  @@index([year])
}

model BusinessClient {
  id        String                  @id @default(uuid())
  name      String
  companyId String
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  company   Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sections  BusinessClientSection[]

  @@unique([name, companyId])
  @@map("Client")
}

model BusinessClientSection {
  id        String               @id @default(uuid())
  title     String
  clientId  String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  notes     BusinessClientNote[]
  client    BusinessClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([title, clientId])
  @@map("ClientSection")
}

model BusinessClientNote {
  id                 String                @id @default(uuid())
  content            String
  sectionId          String
  createdById        String?
  attachment         String?
  expiryDate         DateTime?
  reminderDays       Int?
  notifiedDaysBefore Boolean               @default(false)
  notifiedOnExpiry   Boolean               @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  createdBy          User?                 @relation(fields: [createdById], references: [id])
  section            BusinessClientSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("ClientNote")
}

model ProfileUpdateRequest {
  id           String   @id @default(uuid())
  userId       String
  oldFirstName String
  oldLastName  String
  newFirstName String
  newLastName  String
  status       String   @default("PENDING")
  adminNote    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model CompanyPayment {
  id               String    @id @default(uuid())
  companyId        String
  cost             Float
  subscriptionType String // MONTHLY, ANNUALLY
  status           String    @default("UNPAID") // PAID, UNPAID
  paidAt           DateTime?
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  notifiedExpiryReminder Boolean   @default(false)
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
}

model DayOffRequest {
  id           String   @id @default(uuid())
  userId       String
  type         String   // CASUAL, REGULAR
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reason       String?
  date         DateTime
  daysDeducted Float?   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}
