generator client {
  provider = "prisma-client-js"
}

// F-13: real enums, not bare String. Zod validates the API path, but
// nothing guarded a Prisma Studio edit, a seed script, or a manual SQL fix
// — a single 'Pending' where the code expects 'PENDING' made a row
// invisible to every filter, with no error anywhere. Value sets below are
// taken from actual usage (grepped across the codebase and cross-checked
// against the matching Zod schema), not assumed.
enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEAM_LEADER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
  OFFLINE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  PENDING_CONFIRMATION
  APPROVED
  REJECTED
  COMPLETED
}

enum TaskPaymentStatus {
  PENDING_PAYMENT
  PAID
}

enum ObligationRecurrence {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum DayOffType {
  REGULAR
  SICK
  EMERGENCY
  UNPAID
  CASUAL
}

// F-27: what a short-lived emailed code is being used to prove. One shared
// VerificationCode mechanism, four purposes, rather than four separate
// ad-hoc flows.
enum VerificationPurpose {
  EMAIL_VERIFY
  EMAIL_CHANGE
  MFA_RECOVERY
  PASSWORD_RESET
}

datasource db {
  provider  = "postgresql"
  // Read from the vars Vercel's Supabase Storage integration keeps in sync
  // automatically (POSTGRES_PRISMA_URL = pooled, POSTGRES_URL_NON_POOLING =
  // direct) instead of the old static DATABASE_URL/DIRECT_URL, which had to
  // be copied by hand every time the DB password rotated.
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Company {
  id              String           @id @default(uuid())
  name            String           @unique
  isBanned        Boolean          @default(false)
  // Company Settings: whether a submitted task location auto-verifies
  // against the task's target location at all, for any task belonging to
  // this company. The distance threshold itself is a system-wide setting
  // (SystemSettings.locationVerifyRadiusMeters) — this is deliberately
  // company policy only, not per-task, so one company can't quietly
  // change what another company's tasks do.
  autoVerifyLocation Boolean       @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  businessClients BusinessClient[]
  payments        CompanyPayment[]
  obligations     Obligation[]
  requests        Request[]
  tasks           Task[]
  users           User[]
}

// System Settings: a single-row table (id is always "default") for
// platform-wide configuration a super admin manages from its own page —
// deliberately separate from Company, which holds per-company policy.
// Add new global settings here as plain columns, same pattern as this
// first one.
model SystemSettings {
  id                        String @id @default("default")
  locationVerifyRadiusMeters Int   @default(70)
  updatedAt                 DateTime @updatedAt
}

model SuperAdmin {
  id                 String             @id @default(uuid())
  email              String             @unique
  password           String
  firstName          String
  lastName           String
  avatar             String?
  gender             String             @default("MALE")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  language           String             @default("en")
  username           String             @unique
  sessionVersion     Int                @default(0)
  mustChangePassword Boolean            @default(false)
  // Founder-account protection: enforced by a DB trigger (see the
  // add_superadmin_protection migration), not just app code, since a
  // direct SQL DELETE bypasses application logic entirely. Deliberately a
  // per-row flag rather than hardcoded emails/IDs in application logic —
  // the same "magic identifier baked into code" pattern F-04 already
  // fixed once for credentials.
  isProtected        Boolean            @default(false)
  // F-27 MFA. mfaEnabled is always true and locked on for a protected
  // SuperAdmin (enforced in app logic — see SuperAdminService); mfaSecret
  // is reversibly encrypted with MFA_ENCRYPTION_KEY, not hashed, since the
  // server has to read it back to compute the expected TOTP code on every
  // login. Distinct key from F-02's deleted ENCRYPTION_KEY — different
  // purpose, never to be confused with it.
  mfaEnabled         Boolean            @default(false)
  mfaSecret          String?
  emailVerifiedAt    DateTime?
  auditLogs          AuditLog[]
  trustedDevices     TrustedDevice[]
  verificationCodes  VerificationCode[]
}

model User {
  id                         String                  @id @default(uuid())
  email                      String                  @unique
  password                   String
  firstName                  String
  lastName                   String
  role                       UserRole
  avatar                     String?
  gender                     String                  @default("MALE")
  companyId                  String?
  status                     UserStatus              @default(OFFLINE)
  lastActivity               DateTime                @default(now())
  totalDifficultyPoints      Int                     @default(0)
  // F-07: Decimal, not Float. Float is IEEE-754 double precision; repeated
  // arithmetic on it drifts (0.1 + 0.2 !== 0.3 in floating point), which is
  // unacceptable for a value that gets paid out. Applies to every money/
  // payroll-day field below and in Task, SalaryRecord, SalaryAdjustment,
  // and CompanyPayment.
  salary                     Decimal                 @default(0) @db.Decimal(12, 2)
  language                   String                  @default("en")
  dayOffCredit               Float                   @default(0)
  baseDayOffCredit           Float                   @default(0)
  // No @default: a hardcoded year here meant every account created after
  // that year started with its reset year already in the past, so the
  // first credit reset would wipe a leave balance it had just been given.
  // UserService.create sets this from the account's actual creation year.
  lastDayOffResetYear        Int
  username                   String                  @unique
  sessionVersion             Int                     @default(0)
  mustChangePassword         Boolean                 @default(false)
  // F-27 MFA — see the matching fields on SuperAdmin for the reasoning on
  // why mfaSecret is encrypted, not hashed.
  mfaEnabled                 Boolean                 @default(false)
  mfaSecret                  String?
  emailVerifiedAt            DateTime?
  auditLogs                  AuditLog[]
  trustedDevices             TrustedDevice[]
  verificationCodes          VerificationCode[]
  createdClients             BusinessClient[]        @relation("ClientCreatedBy")
  editedClients              BusinessClient[]        @relation("ClientEditedBy")
  createdBusinessClientNotes BusinessClientNote[]    @relation("CreatedNotes")
  editedBusinessClientNotes  BusinessClientNote[]    @relation("EditedNotes")
  createdSections            BusinessClientSection[] @relation("SectionCreatedBy")
  editedSections             BusinessClientSection[] @relation("SectionEditedBy")
  dayOffCreditSnapshots      DayOffCreditSnapshot[]
  dayOffRequests             DayOffRequest[]
  notifications              Notification[]
  profileUpdateRequests      ProfileUpdateRequest[]
  requests                   Request[]
  salaryAdjustments          SalaryAdjustment[]
  salaryRecords              SalaryRecord[]
  createdTasks               Task[]                  @relation("CreatedTasks")
  company                    Company?                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks                      Task[]                  @relation("MultipleAssignees")
  obligations                Obligation[]            @relation("ObligationAssignees")

  @@index([email])
  @@index([companyId])
  @@index([status])
  @@index([role])
}

model Task {
  id                  String            @id @default(uuid())
  title               String
  description         String
  status              TaskStatus
  deadline            DateTime
  difficulty          Int               @default(0)
  totalCost           Decimal           @default(0) @db.Decimal(12, 2)
  createdBy           String?
  // F-12: Json, not String. These held JSON serialized into text — Postgres
  // couldn't validate, index, or query any of it, and the app already had to
  // defend itself against malformed rows (maintenance.service.ts silently
  // treats an unparseable attachments row as orphaned and deletes it).
  attachments         Json?
  comments            Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  isEdited            Boolean           @default(false)
  isTransfer          Boolean           @default(false)
  paymentStatus       TaskPaymentStatus @default(PENDING_PAYMENT)
  location            String?
  lastStatusUpdateBy  String?
  lastEditBy          String?
  memberCosts         Json?
  memberPaymentStatus Json?
  companyId           String?
  company             Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator             User?             @relation("CreatedTasks", fields: [createdBy], references: [id], onDelete: SetNull)
  assignees           User[]            @relation("MultipleAssignees")

  @@index([createdBy])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
  // F-26: the hot paths filter on these pairs together (company task lists
  // scoped by status; deadline-sorted views scoped by company) — a
  // single-column index can only serve one side of that filter per scan.
  @@index([companyId, status])
  @@index([companyId, deadline])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  relatedId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  // F-26: the notification bell always filters "this user's unread items".
  @@index([userId, read])
}

model AuditLog {
  id           String      @id @default(uuid())
  action       String
  entityType   String
  entityId     String
  userId       String?
  superAdminId String?
  // F-12: Json, not String — see the note on Task.attachments above.
  details      Json?
  createdAt    DateTime    @default(now())
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: SetNull)
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  // F-26: the audit log page's default view is newest-first, filterable by
  // action — the two are always sorted/filtered together there.
  @@index([createdAt, action])
}

// F-27: short-lived one-time codes emailed to prove control of an inbox —
// backs email verification, email change, MFA's email-fallback recovery,
// and forgot-password. `email` is the address the code was actually sent
// to (matters for EMAIL_CHANGE, where that's the *new* address, not
// whatever's on the account row yet). The code itself is hashed, not
// stored raw — a 6-digit code doesn't need bcrypt's cost factor, just
// enough that a DB dump alone doesn't hand out working codes. `attempts`
// backs rate-limiting wrong guesses against a single code.
model VerificationCode {
  id           String              @id @default(uuid())
  userId       String?
  superAdminId String?
  email        String
  codeHash     String
  purpose      VerificationPurpose
  attempts     Int                 @default(0)
  consumedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime            @default(now())
  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  superAdmin   SuperAdmin?         @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([superAdminId])
  @@index([email, purpose])
}

// F-27: a device that has already completed an MFA challenge once, so it
// isn't asked again until this expires or is revoked. `tokenHash`, like
// VerificationCode.codeHash, never stores the raw token actually sitting
// in the browser's cookie.
model TrustedDevice {
  id           String      @id @default(uuid())
  userId       String?
  superAdminId String?
  tokenHash    String      @unique
  label        String?
  createdAt    DateTime    @default(now())
  lastUsedAt   DateTime    @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([superAdminId])
}

model Obligation {
  id                 String               @id @default(uuid())
  title              String
  description        String
  recurrence         ObligationRecurrence @default(ONE_TIME)
  deadline           DateTime
  difficulty         Int                  @default(0)
  status             String
  attachments        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  lastStatusUpdateBy String?
  companyId          String?
  company            Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignees          User[]               @relation("ObligationAssignees")

  @@index([status])
  @@index([companyId])
  @@index([createdAt])
}

model SalaryRecord {
  id         String   @id @default(uuid())
  userId     String
  month      Int
  year       Int
  totalDays  Int
  deductions Decimal  @default(0) @db.Decimal(12, 2)
  bonusDays  Decimal  @default(0) @db.Decimal(12, 2)
  baseSalary Decimal  @default(0) @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId])
  @@index([month])
  @@index([year])
}

model BusinessClient {
  id             String                  @id @default(uuid())
  name           String
  companyId      String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  createdById    String?
  lastEditedById String?
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy      User?                   @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastEditedBy   User?                   @relation("ClientEditedBy", fields: [lastEditedById], references: [id], onDelete: SetNull)
  sections       BusinessClientSection[]

  @@unique([name, companyId])
  @@map("Client")
}

model BusinessClientSection {
  id             String               @id @default(uuid())
  title          String
  clientId       String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  createdById    String?
  lastEditedById String?
  notes          BusinessClientNote[]
  client         BusinessClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy      User?                @relation("SectionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastEditedBy   User?                @relation("SectionEditedBy", fields: [lastEditedById], references: [id], onDelete: SetNull)

  @@unique([title, clientId])
  @@map("ClientSection")
}

model BusinessClientNote {
  id                 String                @id @default(uuid())
  content            String
  sectionId          String
  createdById        String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  attachment         String?
  expiryDate         DateTime?
  notifiedDaysBefore Boolean               @default(false)
  notifiedOnExpiry   Boolean               @default(false)
  reminderDays       Int?
  lastEditedAt       DateTime?
  lastEditedById     String?
  createdBy          User?                 @relation("CreatedNotes", fields: [createdById], references: [id], onDelete: SetNull)
  lastEditedBy       User?                 @relation("EditedNotes", fields: [lastEditedById], references: [id], onDelete: SetNull)
  section            BusinessClientSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("ClientNote")
}

model ProfileUpdateRequest {
  id           String   @id @default(uuid())
  userId       String
  oldFirstName String
  oldLastName  String
  newFirstName String
  newLastName  String
  status       String   @default("PENDING")
  adminNote    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model CompanyPayment {
  id                     String    @id @default(uuid())
  companyId              String
  cost                   Decimal   @db.Decimal(12, 2)
  subscriptionType       String
  status                 String    @default("UNPAID")
  paidAt                 DateTime?
  startDate              DateTime?
  endDate                DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  notifiedExpiryReminder Boolean   @default(false)
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([paidAt])
  @@index([endDate])
}

model DayOffRequest {
  id            String     @id @default(uuid())
  userId        String
  type          DayOffType
  status        String     @default("PENDING")
  reason        String?
  date          DateTime
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  daysDeducted  Float?     @default(0)
  endDate       DateTime?
  deductionType String     @default("CREDIT")
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  // F-26: "this user's requests, filtered by status" is the shape both the
  // employee view and the admin approval queue query.
  @@index([userId, status])
}

model SalaryAdjustment {
  id        String   @id @default(uuid())
  userId    String
  type      String
  amount    Decimal  @db.Decimal(12, 2)
  reason    String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
}

model Request {
  id           String    @id @default(uuid())
  title        String
  details      String
  status       String    @default("PENDING")
  userId       String
  companyId    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  inProgressAt DateTime?
  completedAt  DateTime?
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model DayOffCreditSnapshot {
  id              String   @id @default(uuid())
  userId          String
  year            Int
  baseCredit      Float
  remainingCredit Float
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([userId])
}
