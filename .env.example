# Copy to .env and fill in real values. Never commit the real .env file.

# ---- Database (Supabase Postgres via Prisma) ----
# Pooled connection (port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.[YOUR-ID]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used for migrations.
DIRECT_URL="postgresql://postgres.[YOUR-ID]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ---- Supabase Storage ----
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT].supabase.co"
# Service-role key: full storage/DB access — server-only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Auth (NextAuth.js) ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ---- Cron / scheduled jobs (see vercel.json) ----
# Generate with: openssl rand -base64 32
# Vercel automatically sends this as `Authorization: Bearer $CRON_SECRET`
# when it invokes a scheduled route.
CRON_SECRET=""

# ---- Seed script (prisma/seed.ts) ----
# Required to run `npx tsx prisma/seed.ts` — it refuses to run without at
# least SEED_ADMIN_EMAIL_1 / SEED_ADMIN_PASSWORD_1. _2 is optional, for a
# second super-admin account. Password must be 12+ characters.
SEED_ADMIN_EMAIL_1="you@example.com"
SEED_ADMIN_PASSWORD_1=""
# SEED_ADMIN_USERNAME_1=""
# SEED_ADMIN_FIRST_NAME_1=""
# SEED_ADMIN_LAST_NAME_1=""
# SEED_ADMIN_GENDER_1="MALE"
# SEED_ADMIN_EMAIL_2=""
# SEED_ADMIN_PASSWORD_2=""

# ---- Optional: manual backup trigger (app/api/admin/maintenance/backup) ----
# Fine-grained GitHub PAT scoped to just this repo, "Contents: read and write".
# GITHUB_DISPATCH_TOKEN=""

# ---- Optional: location search (components/LocationSearchInput.tsx) ----
# NEXT_PUBLIC_HERE_API_KEY=""

# ---- Optional: error tracking (Sentry) ----
# Leaving these unset disables Sentry entirely — the SDK no-ops without a DSN.
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""
