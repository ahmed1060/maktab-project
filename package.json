    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vladmandic/face-api": "^1.7.15",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "next": "^16.3.6",
    "next-auth": "^4.24.13",
    "nodemailer": "^10.0.10",
    "otplib": "^13.5.0",
