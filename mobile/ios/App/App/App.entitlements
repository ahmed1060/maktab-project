<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (ATTENDANCE_PLAN.md §13.4). Xcode switches this to production for App Store builds. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- App Attest (ATTENDANCE_PLAN.md §9.4): Apple's production environment, for TestFlight and the App Store; the
	     server accepts it by default. Debug builds use App.Debug.entitlements, with the development one. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
</dict>
</plist>
