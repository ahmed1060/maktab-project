generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String    @id @default(uuid())
  name      String    @unique
  users     User[]
  businessClients BusinessClient[]
  isBanned  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SuperAdmin {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String
  firstName String
  lastName  String
  avatar    String?
  gender    String  @default("MALE") // "MALE" | "FEMALE"

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String
  firstName String
  lastName  String
  role      String // "ADMIN" | "TEAM_LEADER" | "EMPLOYEE" (SUPER_ADMIN moved to separate model)
  avatar    String?
  gender    String  @default("MALE") // "MALE" | "FEMALE"

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  status                String   @default("OFFLINE") // "ACTIVE", "OFFLINE", "SUSPENDED"
  lastActivity          DateTime @default(now())
  totalDifficultyPoints Int      @default(0)
  salary                Float?   @default(0)

  tasks         Task[]         @relation("AssignedTasks")
  obligations   Obligation[]
  notifications Notification[]
  auditLogs     AuditLog[]
  salaryRecords SalaryRecord[]
  createdTasks  Task[]         @relation("CreatedTasks")
  createdBusinessClientNotes BusinessClientNote[]

  @@index([email])
  @@index([companyId])
  @@index([status])
  @@index([role])
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String
  status      String
  deadline    DateTime
  difficulty  Int      @default(0)
  totalCost   Float    @default(0)
  assigneeId  String
  assignee    User     @relation("AssignedTasks", fields: [assigneeId], references: [id])

  createdBy String?
  creator   User?   @relation("CreatedTasks", fields: [createdBy], references: [id])

  attachments        String?
  comments           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  isEdited           Boolean  @default(false)
  isTransfer         Boolean  @default(false)
  paymentStatus      String   @default("PENDING_PAYMENT")
  location           String?
  lastStatusUpdateBy String?
  lastEditBy         String?

  @@index([assigneeId])
  @@index([createdBy])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  read      Boolean  @default(false)
  relatedId String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String @id @default(uuid())
  action     String
  entityType String
  entityId   String

  userId String? // Made optional
  user   User?   @relation(fields: [userId], references: [id])

  superAdminId String?
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id])

  details   String?
  createdAt DateTime @default(now())
}

model Obligation {
  id                 String   @id @default(uuid())
  title              String
  description        String
  assigneeId         String
  assignee           User     @relation(fields: [assigneeId], references: [id])
  recurrence         String   @default("ONE_TIME")
  deadline           DateTime
  difficulty         Int      @default(0)
  status             String
  attachments        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lastStatusUpdateBy String?

  @@index([assigneeId])
  @@index([status])
  @@index([createdAt])
}

model SalaryRecord {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  month      Int
  year       Int
  totalDays  Int
  deductions Float    @default(0)
  bonusDays  Float    @default(0)
  baseSalary Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([userId])
  @@index([month])
  @@index([year])
}

model BusinessClient {
  id   String @id @default(uuid())
  name String

  // The system company this client belongs to
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  sections BusinessClientSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, companyId])
  @@map("Client")
}

model BusinessClientSection {
  id    String @id @default(uuid())
  title String

  clientId  String
  client    BusinessClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  notes BusinessClientNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([title, clientId])
  @@map("ClientSection")
}



model BusinessClientNote {
  id      String @id @default(uuid())
  content String

  sectionId String
  section   BusinessClientSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ClientNote")
}
